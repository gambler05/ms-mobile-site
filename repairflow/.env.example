# ---- Base de données ----------------------------------------------------------
# Démo locale (SQLite). En production multi-utilisateurs : PostgreSQL
# (ex. postgresql://user:pass@host:5432/repairflow) — voir docs/DEPLOIEMENT.md.
DATABASE_URL="file:./dev.db"
# "sqlite" (défaut) ou "postgresql". Doit correspondre au provider du schéma Prisma.
DATABASE_PROVIDER="sqlite"

# ---- Application ---------------------------------------------------------------
APP_URL="http://localhost:3000"
NODE_ENV="development"
# Mode démonstration : aucune communication réelle (email/SMS/WhatsApp) n'est envoyée,
# les envois sont journalisés comme "simulés".
DEMO_MODE="true"

# ---- Secrets serveur (générer avec : openssl rand -base64 32) ------------------
# Clé de chiffrement AES-256-GCM des données sensibles (codes de déverrouillage).
ENCRYPTION_KEY=""
# Secret de signature des cookies de session et des URLs signées de fichiers.
SESSION_SECRET=""
# Jeton partagé protégeant l'endpoint du worker (/api/jobs/run) appelé par le cron.
CRON_SECRET=""

# ---- Stockage objet privé (photos, documents) ---------------------------------
# "local" (dossier ./storage, démo) ou "s3".
STORAGE_DRIVER="local"
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# ---- Canaux de notification (laisser vide = canal « non configuré ») ----------
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="MS MOBILE <no-reply@example.test>"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WEB_PUSH_PUBLIC_KEY=""
WEB_PUSH_PRIVATE_KEY=""

# ---- Assistant métier (facultatif) --------------------------------------------
# Sans clé, l'assistant fonctionne en mode « règles locales » uniquement.
ANTHROPIC_API_KEY=""
ASSISTANT_MODEL="claude-opus-5"

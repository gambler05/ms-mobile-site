{
  "name": "studio-ia",
  "version": "1.0.0",
  "private": true,
  "description": "Studio IA — génération d'images à partir de texte, analyse d'images en prompts, éditeur de prompts et bibliothèque locale.",
  "author": "Studio IA",
  "main": "desktop/main.mjs",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "concurrently -n serveur,web -c magenta,cyan \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch --clear-screen=false server/src/index.ts",
    "dev:web": "vite",
    "build": "npm run build:web && npm run build:server",
    "build:web": "vite build",
    "build:server": "tsc -p server/tsconfig.json",
    "start": "node server/dist/index.js",
    "typecheck": "tsc -p server/tsconfig.json --noEmit && tsc -p server/tsconfig.test.json --noEmit && tsc -p web/tsconfig.json --noEmit && tsc -p e2e/tsconfig.json --noEmit",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run",
    "test:e2e": "npm run build && playwright test --trace off",
    "backup": "tsx server/src/cli/backup.ts",
    "restore": "tsx server/src/cli/restore.ts",
    "doctor": "tsx server/src/cli/doctor.ts",
    "desktop": "npm run build && electron .",
    "desktop:dist": "npm run build && electron-builder --publish never"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.9.0",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "fflate": "^0.8.2",
    "image-size": "^2.0.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@playwright/test": "1.63.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^9.2.5",
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0",
    "lucide-react": "^1.73.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^7.3.8",
    "vitest": "^3.2.7"
  },
  "build": {
    "appId": "fr.studio-ia.app",
    "productName": "Studio IA",
    "copyright": "Studio IA",
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**",
      "server/dist/**",
      "web/dist/**",
      "package.json",
      "!**/*.map"
    ],
    "asar": false,
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "desktop/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Studio IA",
      "installerLanguages": [
        "fr_FR"
      ],
      "language": "1036",
      "artifactName": "Studio-IA-Installation-${version}.${ext}"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.graphics-design",
      "icon": "desktop/icon.png",
      "artifactName": "Studio-IA-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Graphics",
      "icon": "desktop/icon.png",
      "artifactName": "Studio-IA-${version}.${ext}",
      "syncDesktopName": true
    },
    "publish": null
  },
  "desktopName": "studio-ia.desktop"
}

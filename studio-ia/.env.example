# ─────────────────────────────────────────────────────────────────────────────
#  Studio IA — fichier de configuration d'exemple
#
#  1. Copiez ce fichier :      cp .env.example .env      (Windows : copy .env.example .env)
#  2. Renseignez UNIQUEMENT les moteurs que vous voulez utiliser.
#  3. Redémarrez le studio après chaque modification de .env.
#
#  Le fichier .env ne doit jamais être partagé ni envoyé sur Git (il est ignoré).
#  Les clés peuvent aussi être saisies dans l'interface : Paramètres › Moteurs.
#  Une valeur définie ici est prioritaire et n'est pas modifiable depuis l'interface.
#  Les lignes commencées par « # » montrent la valeur par défaut : retirez le « # » pour la changer.
# ─────────────────────────────────────────────────────────────────────────────

# ── Serveur ──────────────────────────────────────────────────────────────────
# Adresse d'écoute. Gardez 127.0.0.1 : le studio n'est alors accessible que depuis cet ordinateur.
HOST=127.0.0.1
PORT=5174
# Dossier des données (bibliothèque, images, réglages). Relatif au dossier studio-ia.
DATA_DIR=data
# Plafond d'images générées par jour (0 = illimité). Utile pour maîtriser les dépenses en mode API.
MAX_IMAGES_PER_DAY=0
# Noms d'hôte supplémentaires autorisés (séparés par des virgules), seulement si vous savez pourquoi.
ALLOWED_HOSTS=

# ── Claude (Anthropic) — analyse d'images + amélioration/traduction de prompts ── API PAYANTE
# Clé : https://console.anthropic.com  › API Keys
ANTHROPIC_API_KEY=
# Modèle (défaut : claude-opus-5-5). Autres choix : claude-sonnet-5-5, claude-haiku-5-5.
# ANTHROPIC_MODEL=claude-opus-5-5
# Effort de réflexion : low, medium, high, xhigh, max (défaut : medium).
# ANTHROPIC_EFFORT=medium

# ── OpenAI Images — génération d'images ── API PAYANTE
# Clé : https://platform.openai.com/api-keys (la génération d'images peut exiger une vérification de l'organisation)
OPENAI_API_KEY=
# Modèle d'image (défaut : gpt-image-2). Le diagnostic liste les modèles disponibles pour votre compte.
# OPENAI_IMAGE_MODEL=gpt-image-2
# true = tailles exactes par format (16:9 → 1536×864…). Mettez false si le modèle les refuse.
# OPENAI_FLEXIBLE_SIZES=true

# ── Stability AI — génération, image de référence, agrandissement ── API PAYANTE (crédits)
# Clé : https://platform.stability.ai  › Account › API Keys
STABILITY_API_KEY=
# core (≈ 3 crédits/image), ultra (≈ 8), sd3.5-large, sd3.5-large-turbo, sd3.5-medium
# STABILITY_MODEL=core

# ── Ollama — analyse d'images + prompts, EN LOCAL ── GRATUIT, HORS LIGNE
# Installation : https://ollama.com/download  puis :  ollama pull qwen2.5vl:7b
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_VISION_MODEL=qwen2.5vl:7b
# Modèle pour le texte seul (vide = même modèle que la vision).
# OLLAMA_TEXT_MODEL=

# ── Stable Diffusion WebUI (Forge / AUTOMATIC1111) — génération EN LOCAL ── GRATUIT, HORS LIGNE
# Lancer WebUI avec l'option --api
# SD_WEBUI_URL=http://127.0.0.1:7860
# Agrandisseur installé dans WebUI
# SD_WEBUI_UPSCALER=R-ESRGAN 4x+
# 1024 pour les modèles SDXL, 512 pour SD 1.5
# SD_WEBUI_BASE_SIZE=1024

# ── Délais maximaux (millisecondes) ──────────────────────────────────────────
# TIMEOUT_API_MS=180000
# Le mode local peut être lent sans carte graphique : 10 minutes par défaut.
# TIMEOUT_LOCAL_MS=600000
